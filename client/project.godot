; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="CyberSeeker"
config/description="Cyberpunk spin game — spins, districts, cartes, collections, events."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

Preferences="*res://scripts/core/Preferences.gd"
Net="*res://scripts/core/Net.gd"
Wallet="*res://scripts/core/Wallet.gd"
Config="*res://scripts/core/Config.gd"
Store="*res://scripts/core/Store.gd"
Sfx="*res://scripts/core/Sfx.gd"
Haptics="*res://scripts/core/Haptics.gd"
Events="*res://scripts/core/Events.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=1170
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
