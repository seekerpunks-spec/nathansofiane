# CYBERSEEKER — serveur (copier en .env et ajuster)

# Base Postgres (voir README : createdb cyberseeker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cyberseeker

# Base DEDIEE aux tests (jamais la base de jeu : les tests y écrivent).
# `cargo test` échoue sans elle — c'est voulu (tests DB fail-closed, R26).
# Saut explicite possible sur une machine sans Postgres :
#   CYBERSEEKER_ALLOW_DB_TEST_SKIP=1  (la gate validate_all.ps1 le refuse)
CYBERSEEKER_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cyberseeker_test

# Secret de signature des JWT (HS256). EN PRODUCTION : changer impérativement
# (>= 32 caractères aléatoires). Cette valeur d'exemple est refusée en release.
JWT_SECRET=dev-only-change-me-32-characters-minimum

# Domaine affiché/signé dans le challenge wallet. Obligatoire en release.
AUTH_DOMAIN=cyberseeker.local

# Répertoire du remote config (relatif au CWD du processus = server/)
CONFIG_DIR=../config

# Port d'écoute
PORT=8080

# --- MODE DEV (à NE JAMAIS activer en production) ---
# DEV_AUTH=true + DEV_ADDRESS : /auth/verify accepte la signature littérale "dev"
# pour cette adresse (aucune vérification Ed25519).
DEV_AUTH=true
DEV_ADDRESS=dev-player-0001

# Rate limiting (fenêtre fixe, par adresse)
RATE_LIMIT_PER_MINUTE=30

# Rétention des données personnelles et journaux (jours, 1..3650).
ANALYTICS_RETENTION_DAYS=90
ECONOMY_AUDIT_RETENTION_DAYS=730
LIVEOPS_ARCHIVE_RETENTION_DAYS=365
DELETION_PROOF_RETENTION_DAYS=30
TEAM_ACTIVITY_RETENTION_DAYS=30

# Logs : info, debug, warn — ex. RUST_LOG=cyberseeker_server=debug
RUST_LOG=info

# Origine web autorisée en production. Sans valeur, aucune origine CORS.
CORS_ORIGIN=http://localhost:8081
